# ─── AWS ──────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# Hoặc để trống nếu dùng IAM Role trên EC2 (recommended)

# ─── S3 ───────────────────────────────────────────────
S3_BUCKET=lakehouse-iceberg-data
S3_RAW_PREFIX=raw/binance/klines
S3_ICEBERG_PREFIX=iceberg

# ─── BINANCE ──────────────────────────────────────────
BINANCE_BASE_URL=https://api.binance.com
# Binance API key không bắt buộc cho public market data
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─── SPARK ────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_LOG_LEVEL=WARN
ICEBERG_CATALOG_NAME=lakehouse
ICEBERG_WAREHOUSE=s3a://lakehouse-iceberg-data/iceberg

# ─── INGESTION ────────────────────────────────────────
DEFAULT_SYMBOL=BTCUSDT
DEFAULT_INTERVAL=1m
# Max candles per API request (Binance limit: 1000)
BINANCE_BATCH_SIZE=1000
